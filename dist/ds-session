#!/bin/sh
# ds session wrapper, installed as /usr/local/bin/ds-session.
# Started by greetd (or a display manager) after login; runs ds on the TTY.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=ds
export XDG_SESSION_DESKTOP=ds

# Make the session variables visible to user services and D-Bus activated
# programs. Failures are ignored: the session works without them.
systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP 2>/dev/null || true
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP 2>/dev/null || true
fi

# Send stdout/stderr to the journal when systemd-cat is available.
if command -v systemd-cat >/dev/null 2>&1; then
    exec systemd-cat -t ds /usr/local/bin/ds --tty
fi
exec /usr/local/bin/ds --tty

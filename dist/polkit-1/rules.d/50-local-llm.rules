// Users in wheel may start and stop the local LLM units without a password.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      /^(llama-(coder|npu|ru-yandex|ru-giga|ru-yandex-cpu|ru-giga-cpu|gavno)|npu-reset)\.service$/.test(action.lookup("unit")) &&
      subject.isInGroup("wheel"))
    return polkit.Result.YES;
});
